{
  "name": "craftnime",
  "version": "1.0.0",
  "description": "Craftnime — Next-Gen Anime Streaming & MyAnimeList Hub",
  "author": "Aditya",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "dist:all": "pnpm build && electron-builder --linux --win",
    "cap:sync": "pnpm build && npx cap sync android",
    "start": "vite"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.craftnime.app",
    "productName": "Craftnime",
    "copyright": "Copyright © 2026 Aditya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "public/Craftnime.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/Craftnime.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
